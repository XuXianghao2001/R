library(umap)
library(ggplot2)
library(dplyr)
library(tidyr)
library(readr)

# 如果还没有安装umap包，请先安装：
# install.packages("umap")

# 读取数据
df <- read.csv("metadata.csv", stringsAsFactors = FALSE)

# 数据预处理 - 创建数值特征用于UMAP
# 1. 对分类变量进行编码
df_encoded <- df %>%
  mutate(
    # 将分类变量转换为因子
    Patient = as.factor(Patient),
    Tissue = as.factor(Tissue),
    Platform = as.factor(Platform),
    Subtype = as.factor(Subtype),
    Type = as.factor(Type)
  )

# 2. 创建数值特征矩阵
# 方法1: 使用one-hot编码
library(caret)

# 选择用于聚类的特征
features_for_clustering <- c("Patient", "Tissue", "Platform", "Subtype", "Type")

# 创建虚拟变量（one-hot编码）
dummy <- dummyVars("~ .", data = df_encoded[, features_for_clustering])
df_numeric <- predict(dummy, newdata = df_encoded)
library(umap)
# 3. 执行UMAP降维
set.seed(123)  # 设置随机种子以确保结果可重现
umap_result <- umap(df_numeric)

# 4. 将UMAP结果添加到数据框中
df_encoded$UMAP1 <- umap_result$layout[, 1]
df_encoded$UMAP2 <- umap_result$layout[, 2]

# 5. 可视化UMAP结果
# 按组织类型着色
p1 <- ggplot(df_encoded, aes(x = UMAP1, y = UMAP2, color = Tissue)) +
  geom_point(size = 2, alpha = 0.7) +
  scale_color_manual(values = c("Normal" = "blue", "Tumor" = "red")) +
  labs(title = "UMAP降维 - 按组织类型着色", 
       x = "UMAP维度1", 
       y = "UMAP维度2") +
  theme_minimal() +
  theme(legend.position = "right")

print(p1)

# 按患者着色
p2 <- ggplot(df_encoded, aes(x = UMAP1, y = UMAP2, color = Patient)) +
  geom_point(size = 2, alpha = 0.7) +
  labs(title = "UMAP降维 - 按患者着色", 
       x = "UMAP维度1", 
       y = "UMAP维度2") +
  theme_minimal() +
  theme(legend.position = "right")

print(p2)

# 按亚型着色
p3 <- ggplot(df_encoded, aes(x = UMAP1, y = UMAP2, color = Subtype)) +
  geom_point(size = 2, alpha = 0.7) +
  labs(title = "UMAP降维 - 按亚型着色", 
       x = "UMAP维度1", 
       y = "UMAP维度2") +
  theme_minimal() +
  theme(legend.position = "right")

print(p3)

# 组合图 - 按组织和患者
p4 <- ggplot(df_encoded, aes(x = UMAP1, y = UMAP2, color = Tissue, shape = Patient)) +
  geom_point(size = 2, alpha = 0.7) +
  scale_color_manual(values = c("Normal" = "blue", "Tumor" = "red")) +
  labs(title = "UMAP降维 - 组织和患者", 
       x = "UMAP维度1", 
       y = "UMAP维度2") +
  theme_minimal()

print(p4)

# 6. 交互式可视化（可选）
# 如果你想要交互式图表，可以安装并使用plotly
# install.packages("plotly")
library(plotly)

p_interactive <- plot_ly(df_encoded, 
                         x = ~UMAP1, 
                         y = ~UMAP2, 
                         color = ~Tissue,
                         text = ~paste("Patient:", Patient, 
                                       "<br>Subtype:", Subtype,
                                       "<br>Sample:", Sample),
