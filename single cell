)

cat(umap_report)




# 读取数据
reference <- qread("sc_dataset.qs")

# 下采样并处理数据
reference <- subset(reference, downsample = 2000)
reference <- SCTransform(reference, ncells = 3000, verbose = FALSE) %>%
  RunPCA(verbose = FALSE) %>%
  RunUMAP(dims = 1:30)

# 绘制图形
DimPlot(reference, group.by = "celltype", label = TRUE)

#1.寻找转移锚点
anchors <- FindTransferAnchors(
  reference = reference,
  query = sce, 
  normalization.method = "SCT"
)

# 2. 转移数据（细胞类型预测）
predictions.assay <- TransferData(
  anchorset = anchors,
  refdata = reference$celltype,
  prediction.assay = TRUE,
  weight.reduction = sce[["pca"]],
  dims = 1:30
)

# 3. 将预测结果添加到查询对象
sce[["predictions"]] <- predictions.assay

# 4. 查看预测结果
head(sce[["predictions"]])

# 5. 可视化预测结果（可选）
SpatialFeaturePlot(sce, features = rownames(sce[["predictions"]])[1:4])

