print(p_interactive)

# 7. 保存UMAP结果
df_with_umap <- df_encoded %>%
  select(Sample, Patient, Tissue, Platform, Subtype, Type, UMAP1, UMAP2)

write.csv(df_with_umap, "metadata_with_umap.csv", row.names = FALSE)
print("UMAP结果已保存为 'metadata_with_umap.csv'")

# 8. UMAP参数调优（可选）
# 你可以尝试不同的UMAP参数以获得更好的分离效果

# 使用自定义参数
umap_custom <- umap(df_numeric, 
                    n_neighbors = 15,      # 邻居数量
                    min_dist = 0.1,        # 点之间的最小距离
                    metric = "euclidean")  # 距离度量

df_encoded$UMAP1_custom <- umap_custom$layout[, 1]
df_encoded$UMAP2_custom <- umap_custom$layout[, 2]

# 可视化自定义参数的结果
